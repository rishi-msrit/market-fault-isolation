# Connection strings for local development (Docker Compose)
PRIMARY_DSN=postgresql://postgres:postgres@localhost:5432/marketdata
REPLICA_DSN=postgresql://postgres:postgres@localhost:5433/marketdata

# For deployed backend (Render) — set this to your Neon connection string
# PRIMARY_DSN=postgresql://user:pass@host/dbname?sslmode=require
# REPLICA_DSN=  # leave blank if using single-DB mode on Neon
